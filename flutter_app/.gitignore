# Flutter/Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
*.iml
.idea/
.metadata

# Android runner is generated and committed (see README) — gradle-wrapper
# .jar IS committed on purpose (that's what makes `gradlew` work on a clean
# checkout with no local Gradle install); local.properties holds this
# machine's absolute SDK paths and must never be, same idea as pubspec.lock
# being committed but .dart_tool/ above not being.
/android/.gradle/
/android/local.properties
/android/**/*.iml
/android/app/build/

# Platform scaffolds not generated for this repo yet
/ios/
/macos/
/linux/
/windows/
